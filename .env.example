# Application
PORT=8000
# Comma-separated additional CORS origins. http://localhost:3000 is already allowed by default.
CORS_ALLOWED_IPS=http://localhost:5173

# PostgreSQL
# The current TypeORM config reads this URL directly.
POSTGRES_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_assistant

# Redis / Bull queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=replace-with-redis-password
# REDIS_DB=0

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
HASH_SALT=10

# Groq LLM
GROQ_API_KEY=replace-with-groq-api-key
# The code currently reads GROQ_MODEL_MODEL.
GROQ_MODEL_MODEL=llama3-8b-8192

# Telegram bot
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_WEBHOOK_DOMAIN=https://example.com

# Bull Board admin UI
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=replace-with-bull-board-password

# Email credential encryption
# Base64-encoded PEM contents. For example: base64 -i public.pem | tr -d '\n'
CRYPTO_PUBLIC_KEY=replace-with-base64-encoded-public-key
CRYPTO_PRIVATE_KEY=replace-with-base64-encoded-private-key
